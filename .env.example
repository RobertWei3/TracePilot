# Discovery only. Replay, reset and tests never read this.
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the discovery loop (default: claude-sonnet-5)
TRACEPILOT_MODEL=claude-sonnet-5
# Reasoning depth for the discovery loop: low | medium | high | xhigh | max
TRACEPILOT_EFFORT=medium

# DemoBank operator credentials. Resolved inside the browser layer only;
# never sent to the model, never written to an artifact, log or screenshot.
DEMOBANK_USER=operator
DEMOBANK_PASS=demo-pass-4417

# Developer-only. Enables raw Playwright tracing, which is NOT sanitized.
# Never set this when producing evidence.
TRACEPILOT_TRACE=0
