# Discovery only. Replay and reset never need a key; without one the live
# smoke test is skipped. Set one provider. DeepSeek wins if both are set.
DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Model used by the discovery loop. Empty means the provider's default:
# deepseek-flash (DeepSeek) or claude-sonnet-5-5 (Anthropic).
TRACEPILOT_MODEL=
# Reasoning depth for the discovery loop: low | medium | high | xhigh | max
TRACEPILOT_EFFORT=medium

# DemoBank operator credentials. Resolved inside the browser layer only;
# never sent to the model, never written to an artifact, log or screenshot.
# Every registered secret is redacted wherever it appears, so choose values
# that are not ordinary words: a username of "operator" would redact that word
# out of every log line, event types included.
DEMOBANK_USER=teller-7q2
DEMOBANK_PASS=demo-pass-4417

# Developer-only. Enables raw Playwright tracing, which is NOT sanitized.
# Never set this when producing evidence.
TRACEPILOT_TRACE=0
